{
  "routes": {
    "GET /api/projects": { "resource": "project", "action": "read" },
    "POST /api/projects": { "resource": "project", "action": "create" },
    "GET /api/projects/:id": { "resource": "project", "action": "read" },
    "PATCH /api/projects/:id": { "resource": "project", "action": "update" },
    "DELETE /api/projects/:id": { "resource": "project", "action": "delete" },
    "GET /api/projects/:id/wbs": { "resource": "wbs", "action": "read" },
    "POST /api/projects/:id/wbs": { "resource": "wbs", "action": "create" },
    "PATCH /api/projects/:id/wbs/:nodeId": { "resource": "wbs", "action": "update" },
    "DELETE /api/projects/:id/wbs/:nodeId": { "resource": "wbs", "action": "delete" },
    "GET /api/projects/:id/daily": { "resource": "dailyReport", "action": "read" },
    "POST /api/projects/:id/daily": { "resource": "dailyReport", "action": "create" },
    "GET /api/projects/:id/quality": { "resource": "quality", "action": "read" },
    "POST /api/projects/:id/quality": { "resource": "quality", "action": "create" },
    "GET /api/projects/:id/safety": { "resource": "safety", "action": "read" },
    "POST /api/projects/:id/safety": { "resource": "safety", "action": "create" },
    "GET /api/invitations": { "resource": "invitation", "action": "read" },
    "POST /api/invitations": { "resource": "invitation", "action": "create" },
    "GET /api/dashboard": { "resource": "dashboard", "action": "read" }
  }
}
