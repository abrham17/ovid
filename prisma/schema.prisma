  PERMIT
  METHOD_STATEMENT
  REPORT
  OTHER
}

enum DocStatus {
  DRAFT
  UNDER_REVIEW
  ISSUED
  SUPERSEDED
  WITHDRAWN
}

enum DecisionType {
  DESIGN_CHANGE
  DELAY_RULING
  VARIATION_APPROVAL
