// Ovid Construction PLC — Project Management System
// Data model per design file 07 (PMS Data Model — Table-by-Table Catalog).
// All 14 domains, mirroring ISO 9001/10006 document control and Ethiopian
// Grade-1 construction practice (IPC, FIDIC variations, MoUDC grading).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

// Layer 1 — organization/party layer of the RBAC model (file 09).
enum PartyType {
  CONTRACTOR
  CLIENT
  CONSULTANT
  SUBCONTRACTOR
  SUPPLIER
  REGULATOR
}

enum ContractorGrade {
  GRADE_1
  GRADE_2
  GRADE_3
  GRADE_4
  GRADE_5
  GRADE_6
  GRADE_7
  GRADE_8
  GRADE_9
  GRADE_10
}

// Layer 2 — functional role (16 values, file 07 §1.2 / file 09).
enum UserRole {
  FOREMAN
  SUPERINTENDENT
  SITE_ENGINEER
  DEPUTY_PM
  SENIOR_PM
  QC_INSPECTOR
  HSE_OFFICER
  QS
  PROCUREMENT
  FINANCE
  HR
  EQUIPMENT_MANAGER
  CONTRACTS_LEGAL
  CONSULTANT_ENGINEER
  CLIENT_REP
  ADMIN
  SUBCONTRACTOR_PM
}

enum DocDept {
  ENG
  QC
  HSE
  FINANCE
  HR
  PROCUREMENT
  CONTRACTS
}

enum SignOffRole {
  FOREMAN
  SUPERINTENDENT
  DEPUTY_PM
  SENIOR_PM
  CONTRACTOR_PREPARED_BY
  CONTRACTOR_CHECKED_BY
  CONSULTANT_CHECKED_BY
  CONSULTANT_APPROVED_BY
  RESIDENT_ENGINEER
  WORK_INSPECTOR
  CONTRACTOR_REP
}

enum ProjectType {
  ROAD
  BUILDING
  HOUSING
  ENERGY
  GREEN_PARK
  OTHER
}

enum ContractType {
  FIDIC_RED
  FIDIC_YELLOW
  ETHIO_STANDARD
  OTHER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  SUSPENDED
  COMPLETE
  CLOSED
}

enum WBSNodeType {
  PHASE
  SECTION
  FLOOR
  STATION_RANGE
  STRUCTURAL_ELEMENT
  ACTIVITY
}

enum ActivityStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  ON_HOLD
}

enum DependencyType {
  FS
  SS
  FF
  SF
}

enum StoppageType {
  WEATHER
  DESIGN_CHANGE
  MATERIAL_SHORTAGE
  CLIENT_INSTRUCTION
  EQUIPMENT_BREAKDOWN
  LABOR_DISPUTE
  FORCE_MAJEURE
