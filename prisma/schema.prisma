/// Polymorphic review/comment system.
/// entityType can be: "daily_report", "inspection", "activity", "dependency_request",
/// "schedule_change", "contract", "document", "defect", "punch_item", "measurement", "variation"
/// Comments are append-only — never edited or deleted.
model ReviewComment {
  id            String   @id @default(cuid())
  projectId     String
  entityType    String
  entityId      String
  userId        String
  parentId      String? // for threaded replies; null = top-level comment
  body          String
  isDecision    Boolean  @default(false) // marks a formal review decision
  decisionLabel String? // "APPROVED", "CHANGES_REQUESTED", "REJECTED", etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id])
  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent  ReviewComment?  @relation("CommentReply", fields: [parentId], references: [id])
  replies ReviewComment[] @relation("CommentReply")

  @@index([entityType, entityId, createdAt])
  @@index([projectId, entityType])
  @@index([userId])
  @@index([parentId])
}

