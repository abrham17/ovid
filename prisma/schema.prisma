// Ovid Construction PLC — Project Management System
// Data model per design file 07 (PMS Data Model — Table-by-Table Catalog).
// All 14 domains, mirroring ISO 9001/10006 document control and Ethiopian
// Grade-1 construction practice (IPC, FIDIC variations, MoUDC grading).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

