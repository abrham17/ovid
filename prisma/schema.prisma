// ============================================================
// 14. Weighted progress tracking, plan approval & oversight
//     (file 20 — the contractor↔subcontractor verification chain)
// ============================================================

/// A WBS node is not authoritative until it is ACTIVE. Nodes created inside a
/// subcontractor's plan submission stay DRAFT: excluded from the progress
/// rollup, from daily reporting, and from every party outside the submitting
/// org until the Contractor PM approves the submission (file 20 §3.2).
enum WbsNodeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WbsPlanSubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

/// Bundles a subcontractor's whole decomposition of one contracted branch into
/// a single review unit. Approving node-by-node would let a plan go live while
/// only partly decomposed, silently breaking the 100% Rule mid-review — so the
/// Contractor PM approves a complete, internally consistent plan or nothing
/// (file 20 §3.2).
model WbsPlanSubmission {
  id                String                  @id @default(cuid())
  projectId         String
  contractId        String
  /// The contract's scope root being decomposed. Every node in this submission
  /// must be a descendant of it.
  rootWbsNodeId     String
  title             String
  status            WbsPlanSubmissionStatus @default(DRAFT)
  createdById       String
  submittedById     String?
  submittedAt       DateTime?
  reviewedById      String?
  reviewedAt        DateTime?
  reviewComments    String?
  /// Snapshot of the recursive 100%-Rule check that passed at submission time.
  validationSummary Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  rootWbsNode WbsNode   @relation("PlanSubmissionRoot", fields: [rootWbsNodeId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("PlanCreatedBy", fields: [createdById], references: [id])
  submittedBy User?     @relation("PlanSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy  User?     @relation("PlanReviewedBy", fields: [reviewedById], references: [id])
  /// Every WBSNode created as part of this submission (file 20's linkedWbsNodeIds,
  /// normalized as a back-relation).
  nodes       WbsNode[] @relation("PlanSubmissionNodes")

  @@index([projectId, status])
  @@index([contractId, status])
  @@index([rootWbsNodeId])
  @@index([createdById])
}

/// Contractor staff mirroring a subcontract's branch to independently verify it
/// — clerk-of-works / owner's-representative authority. Deliberately a separate
/// table from SectionAssignment/ActivityAssignment: those record who EXECUTES
/// work, this records who VERIFIES it. Conflating them would blur the same
/// segregation-of-duties line file 18 §7.2 draws for QC independence
/// (file 20 §5.4).
model OversightAssignment {
  id             String    @id @default(cuid())
  projectId      String
  userId         String
  contractId     String
  /// Mirrors the subcontract's own scopeWbsNodeId — the same branch, watched
  /// from the other side.
  scopeWbsNodeId String
  assignedById   String
  assignedAt     DateTime  @default(now())
  endedAt        DateTime?
  supersededById String?

  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User                  @relation("OversightAssignedTo", fields: [userId], references: [id])
  assignedBy   User                  @relation("OversightAssignedBy", fields: [assignedById], references: [id])
  contract     Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  scopeWbsNode WbsNode               @relation(fields: [scopeWbsNodeId], references: [id], onDelete: Cascade)
  supersededBy OversightAssignment?  @relation("OversightSupersede", fields: [supersededById], references: [id])
  supersedes   OversightAssignment[] @relation("OversightSupersede")
  dailyEntries OversightDailyEntry[]

  @@index([userId, endedAt])
  @@index([projectId, contractId, endedAt])
  @@index([contractId, endedAt])
  @@index([scopeWbsNodeId])
}

/// How the oversight observer's own measurement compares to what the
/// subcontractor reported for the same work on the same day.
enum OversightAssessment {
  NOT_ASSESSED
  MATCHES_REPORTED
  BELOW_REPORTED
  ABOVE_REPORTED
}

/// The contractor's OWN daily record over a subcontractor's work — a
/// structurally separate record, not a countersignature on the subcontractor's
/// entry. Two independent, attributable reports covering the same physical work
/// from two organizations, so a later completion claim that was never
/// corroborated is documented in real time rather than discovered at
/// IPC-reconciliation time (file 20 §5.4).
model OversightDailyEntry {
  id                    String              @id @default(cuid())
  projectId             String
  contractId            String
  wbsNodeId             String
  oversightAssignmentId String
  date                  DateTime            @db.Date
  activityDescription   String
  /// What the oversight observer independently measured.
  observedQuantity      Decimal?            @db.Decimal(12, 3)
  observedUnit          String?
  /// What the subcontractor reported for the same work/day, captured at entry
  /// time so the variance is frozen against what was actually claimed then.
  reportedQuantity      Decimal?            @db.Decimal(12, 3)
  quantityAssessment    OversightAssessment @default(NOT_ASSESSED)
  qualityAssessment     String?
  concernsRaised        String?
  manpowerObserved      Int?
  status                DailyReportStatus   @default(DRAFT)
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract            Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  wbsNode             WbsNode             @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)
  oversightAssignment OversightAssignment @relation(fields: [oversightAssignmentId], references: [id], onDelete: Cascade)
  createdBy           User                @relation("OversightEntriesCreated", fields: [createdById], references: [id])

  @@index([projectId, date])
  @@index([contractId, date])
  @@index([wbsNodeId])
  @@index([oversightAssignmentId])
  @@index([status])
}

