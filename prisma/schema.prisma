/// A subcontractor asking the main contractor to source materials/equipment for
/// their branch. Approval is gated to the holder of an active
/// OversightAssignment over the requesting contract — they have watched the
/// actual progress firsthand, so they can judge whether the ask is justified,
/// rather than routing every request to the Contractor PM (file 20 §5.4).
model ResourceRequest {
  id               String                @id @default(cuid())
  projectId        String
  contractId       String
  wbsNodeId        String
  kind             ResourceRequestKind
  materialItemId   String?
  equipmentId      String?
  description      String
  quantity         Decimal               @db.Decimal(18, 3)
  unit             String?
  neededByDate     DateTime              @db.Date
  justification    String
  status           ResourceRequestStatus @default(PENDING)
  requestedById    String
  reviewedById     String?
  reviewedAt       DateTime?
  decisionReason   String?
  /// Populated on approval — the MaterialDemand this request became, so the
  /// existing procurement pipeline picks it up unchanged.
  materialDemandId String?               @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract       Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  wbsNode        WbsNode         @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)
  materialItem   MaterialItem?   @relation(fields: [materialItemId], references: [id])
  equipment      Equipment?      @relation(fields: [equipmentId], references: [id])
  requestedBy    User            @relation("ResourceRequestedBy", fields: [requestedById], references: [id])
  reviewedBy     User?           @relation("ResourceRequestReviewedBy", fields: [reviewedById], references: [id])
  materialDemand MaterialDemand? @relation(fields: [materialDemandId], references: [id])

  @@index([projectId, status])
  @@index([contractId, status])
  @@index([wbsNodeId])
  @@index([requestedById])
  @@index([neededByDate])
}
