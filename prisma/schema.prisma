// ============================================================
// 1. Identity & Organization
// ============================================================

model Organization {
  id              String           @id @default(cuid())
  name            String
  nameAmharic     String?
  partyType       PartyType
  contractorGrade ContractorGrade?
  licenseNumber   String?
  taxId           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  users                  User[]
  projectsAsContractor   Project[]                @relation("ProjectContractor")
  projectsAsClient       Project[]                @relation("ProjectClient")
  projectsAsConsultant   Project[]                @relation("ProjectConsultant")
  memberships            ProjectMembership[]
  invitations            Invitation[]
  contractsExecuted      Contract[]               @relation("ContractOrg")
  employees              Employee[]
  equipment              Equipment[]
  defectsResponsible     DefectLog[]
  purchaseOrders         PurchaseOrder[]          @relation("POSupplier")
  bids                   BidTender[]              @relation("BidOrg")
  bidsOwned              BidTender[]              @relation("BidOwnerOrg")
  companyAssignments     CompanyStaffAssignment[]
  companyInvitations     CompanyInvitation[]
  approvals              CompanyApproval[]
  designReviews          DesignReview[]
  auditFindings          AuditFinding[]
  executiveInterventions ExecutiveIntervention[]

  @@index([partyType])
  @@index([name])
}

model User {
  id                 String   @id @default(cuid())
  organizationId     String
  fullName           String
  email              String   @unique
  passwordHash       String
  phone              String?
  jobTitle           String
  role               UserRole
  signatureImageUrl  String?
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization                  Organization                 @relation(fields: [organizationId], references: [id])
  memberships                   ProjectMembership[]
  companyAssignments            CompanyStaffAssignment[]
  assignedCompanyRoles          CompanyStaffAssignment[]     @relation("CompanyAssignmentAssigner")
  companyInvitationsSent        CompanyInvitation[]          @relation("CompanyInvitationsSent")
  companyApprovalsRequested     CompanyApproval[]            @relation("ApprovalRequester")
  companyApprovalsReviewed      CompanyApproval[]            @relation("ApprovalReviewer")
  invitationsSent               Invitation[]                 @relation("InvitationsSent")
  invitationAccepted            Invitation?                  @relation("InvitationAccepted")
  signOffs                      SignOff[]
  riskOwner                     RiskEntry[]                  @relation("RiskOwner")
  observations                  SafetyObservation[]
  incidentsVerified             SafetyIncident[]             @relation("IncidentVerifiedBy")
  inspections                   InspectionTestRecord[]
  custodyTransfers              CustodyLog[]                 @relation("CustodyTransferor")
  custodyReceipts               CustodyLog[]                 @relation("CustodyReceiver")
  auditEntries                  AuditLog[]
  earthworkEntries              EarthworkDailyEntry[]        @relation("EarthworkEntriesCreated")
  structureEntries              StructureDailyEntry[]        @relation("StructureEntriesCreated")
  rebarEntries                  RebarDailyEntry[]            @relation("RebarEntriesCreated")
  documentsIssued               ProjectDocument[]            @relation("DocIssuedBy")
  documentsApproved             ProjectDocument[]            @relation("DocApprovedBy")
  decisions                     DecisionLog[]
  lessonsLearned                LessonsLearned[]
  bidsSubmitted                 BidTender[]                  @relation("BidSubmittedBy")
  tendersOwned                  BidTender[]                  @relation("TenderOwner")
  designReviewsSubmitted        DesignReview[]               @relation("DesignReviewSubmitter")
  designReviewsReviewed         DesignReview[]               @relation("DesignReviewReviewer")
  auditFindingsRaised           AuditFinding[]               @relation("AuditFindingRaisedBy")
  auditFindingsOwned            AuditFinding[]               @relation("AuditFindingOwner")
  auditFindingsVerified         AuditFinding[]               @relation("AuditFindingVerifier")
  equipmentAllocationsMade      EquipmentAllocation[]
  executiveInterventionsCreated ExecutiveIntervention[]      @relation("ExecutiveInterventionCreator")
  executiveInterventionsOwned   ExecutiveIntervention[]      @relation("ExecutiveInterventionOwner")
  executiveInterventionsClosed  ExecutiveIntervention[]      @relation("ExecutiveInterventionCloser")
  executiveInterventionEvents   ExecutiveInterventionEvent[]
  materialReceipts              MaterialReceipt[]
  notifications                 Notification[]
  activityAssignments           ActivityAssignment[]         @relation("ActivityAssignedTo")
  assignedAssignments           ActivityAssignment[]         @relation("ActivityAssignedBy")
  sectionAssignments            SectionAssignment[]          @relation("SectionAssignedTo")
  assignedSections              SectionAssignment[]          @relation("SectionAssignedBy")
  dependencyRequestsMade        PendingDependencyRequest[]   @relation("DepReqRequestedBy")
  dependencyRequestsReviewed    PendingDependencyRequest[]   @relation("DepReqReviewedBy")
  disputesOpened                DisputeRecord[]              @relation("DisputeOpenedBy")
  disputesResolved              DisputeRecord[]              @relation("DisputeResolvedBy")
  reviewComments                ReviewComment[]
  scheduleChangesRequested      ScheduleChangeRequest[]      @relation("ScheduleChangeRequester")
  scheduleChangesReviewed       ScheduleChangeRequest[]      @relation("ScheduleChangeReviewer")
  plansCreated                  WbsPlanSubmission[]          @relation("PlanCreatedBy")
  plansSubmitted                WbsPlanSubmission[]          @relation("PlanSubmittedBy")
  plansReviewed                 WbsPlanSubmission[]          @relation("PlanReviewedBy")
  oversightAssignments          OversightAssignment[]        @relation("OversightAssignedTo")
  assignedOversights            OversightAssignment[]        @relation("OversightAssignedBy")
  oversightEntries              OversightDailyEntry[]        @relation("OversightEntriesCreated")
  resourceRequestsMade          ResourceRequest[]            @relation("ResourceRequestedBy")
  resourceRequestsReviewed      ResourceRequest[]            @relation("ResourceRequestReviewedBy")
  assignedProjectRoles          ProjectRoleAssignment[]      @relation("AssignedProjectUser")
  assignedByProjectRoles        ProjectRoleAssignment[]      @relation("AssignedByProjectUser")
  projectObjectivesCreated      ProjectObjective[]           @relation("ProjectObjectiveCreator")
  baselinesCreated              ProjectBaseline[]            @relation("BaselineCreatedBy")
  baselinesSubmitted            ProjectBaseline[]            @relation("BaselineSubmittedBy")
  baselinesApproved             ProjectBaseline[]            @relation("BaselineApprovedBy")
  projectStatusChanges          ProjectStatusHistory[]

  @@index([organizationId])
  @@index([role])
}

model ProjectMembership {
  id             String @id @default(cuid())
  projectId      String
  userId         String
  organizationId String
  projectRole    String

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([projectId, userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model CompanyStaffAssignment {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           CompanyStaffRole
  active         Boolean          @default(true)
  assignedAt     DateTime         @default(now())
  endedAt        DateTime?
  assignedById   String?
  reason         String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedBy   User?        @relation("CompanyAssignmentAssigner", fields: [assignedById], references: [id])

  @@index([userId, organizationId, role, active])
  @@index([organizationId, active])
  @@index([userId, active])
}

model CompanyInvitation {
  id             String           @id @default(cuid())
  email          String
  fullName       String
  jobTitle       String
  role           CompanyStaffRole
  organizationId String
  invitedById    String
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("CompanyInvitationsSent", fields: [invitedById], references: [id])

  @@index([organizationId, status])
  @@index([email])
}

model CompanyApproval {
  id                String                @id @default(cuid())
  organizationId    String
  type              CompanyApprovalType
  status            CompanyApprovalStatus @default(PENDING)
  entityType        String
  entityId          String
  requestedById     String
  reviewedById      String?
  amount            Decimal?              @db.Decimal(18, 2)
  thresholdSnapshot Json?
  comment           String?
  requestedAt       DateTime              @default(now())
  reviewedAt        DateTime?
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy       User                  @relation("ApprovalRequester", fields: [requestedById], references: [id])
  reviewedBy        User?                 @relation("ApprovalReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId, status])
  @@index([entityType, entityId])
}

model DesignReview {
  id             String             @id @default(cuid())
  organizationId String
  projectId      String
  wbsNodeId      String?
  title          String
  documentRef    String
  reviewType     String
  safetyCritical Boolean            @default(false)
  status         DesignReviewStatus @default(DRAFT)
  findings       Json?
  resolution     String?
  submittedById  String
  reviewedById   String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode      WbsNode?     @relation(fields: [wbsNodeId], references: [id])
  submittedBy  User         @relation("DesignReviewSubmitter", fields: [submittedById], references: [id])
  reviewedBy   User?        @relation("DesignReviewReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId, status])
  @@index([projectId, status])
}

model AuditFinding {
  id              String             @id @default(cuid())
  organizationId  String
  projectId       String?
  title           String
  description     String
  severity        String
  status          AuditFindingStatus @default(OPEN)
  evidenceRef     String?
  remediationPlan String?
  managementReply String?
  dueAt           DateTime?
  raisedById      String
  ownerId         String?
  verifiedById    String?
  verifiedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  raisedBy     User         @relation("AuditFindingRaisedBy", fields: [raisedById], references: [id])
  owner        User?        @relation("AuditFindingOwner", fields: [ownerId], references: [id])
  verifiedBy   User?        @relation("AuditFindingVerifier", fields: [verifiedById], references: [id])

  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([dueAt])
}

model ExecutiveIntervention {
  id                String                        @id @default(cuid())
  organizationId    String
  projectId         String
  category          ExecutiveInterventionCategory
  priority          ExecutiveInterventionPriority @default(HIGH)
  status            ExecutiveInterventionStatus   @default(OPEN)
  title             String
  description       String
  requiredAction    String
  sourceType        String?
  sourceId          String?
  accountableUserId String
  createdById       String
  dueAt             DateTime
  closedById        String?
  closedAt          DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accountableUser User                         @relation("ExecutiveInterventionOwner", fields: [accountableUserId], references: [id])
  createdBy       User                         @relation("ExecutiveInterventionCreator", fields: [createdById], references: [id])
  closedBy        User?                        @relation("ExecutiveInterventionCloser", fields: [closedById], references: [id])
  events          ExecutiveInterventionEvent[]

  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([accountableUserId, status])
  @@index([dueAt, status])
}

model ExecutiveInterventionEvent {
  id             String                         @id @default(cuid())
  interventionId String
  type           ExecutiveInterventionEventType
  authorId       String
  comment        String
  oldStatus      ExecutiveInterventionStatus?
  newStatus      ExecutiveInterventionStatus?
  oldDueAt       DateTime?
  newDueAt       DateTime?
  createdAt      DateTime                       @default(now())

  intervention ExecutiveIntervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  author       User                  @relation(fields: [authorId], references: [id])

  @@index([interventionId, createdAt])
  @@index([authorId, createdAt])
}

// ============================================================
// 2. Document Control (ISO 9001 §7.5 backbone)
// ============================================================

model DocumentTemplate {
  id                String   @id @default(cuid())
  docNo             String   @unique
  title             String
  issuingDepartment DocDept
  revisionNo        Int
  effectiveDate     DateTime
  supersededById    String?
  formSchema        Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  supersededBy DocumentTemplate?  @relation("DocRevisions", fields: [supersededById], references: [id])
  revisions    DocumentTemplate[] @relation("DocRevisions")
}

model SignOff {
  id          String      @id @default(cuid())
  entityType  String
  entityId    String
  userId      String
  signOffRole SignOffRole
  signedAt    DateTime
  comment     String?

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([signOffRole])
}

// ============================================================
// 3. Project & Contract
// ============================================================

model Project {
  id               String        @id @default(cuid())
  code             String        @unique
  name             String
  projectType      ProjectType
  contractorOrgId  String
  clientOrgId      String
  consultantOrgId  String?
  contractValue    Decimal       @db.Decimal(18, 2)
  contractType     ContractType
  plannedStartDate DateTime
  plannedEndDate   DateTime
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  status           ProjectStatus @default(PLANNING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  contractorOrg             Organization               @relation("ProjectContractor", fields: [contractorOrgId], references: [id])
  clientOrg                 Organization               @relation("ProjectClient", fields: [clientOrgId], references: [id])
  consultantOrg             Organization?              @relation("ProjectConsultant", fields: [consultantOrgId], references: [id])
  memberships               ProjectMembership[]
  invitations               Invitation[]
  contracts                 Contract[]
  wbsNodes                  WbsNode[]
  stoppages                 StoppageEntry[]
  variations                VariationOrder[]
  risks                     RiskEntry[]
  equipmentUsage            EquipmentUsageLog[]
  regulatoryReports         RegulatoryReport[]
  earthworkDailyEntries     EarthworkDailyEntry[]
  structureDailyEntries     StructureDailyEntry[]
  rebarDailyEntries         RebarDailyEntry[]
  documents                 ProjectDocument[]
  decisions                 DecisionLog[]
  lessonsLearned            LessonsLearned[]
  purchaseOrders            PurchaseOrder[]
  bids                      BidTender[]
  materialReceipts          MaterialReceipt[]
  notifications             Notification[]
  pendingDependencyRequests PendingDependencyRequest[]
  disputeRecords            DisputeRecord[]
  reviewComments            ReviewComment[]
  scheduleChangeRequests    ScheduleChangeRequest[]
  sectionAssignments        SectionAssignment[]
  wbsPlanSubmissions        WbsPlanSubmission[]
  oversightAssignments      OversightAssignment[]
  oversightDailyEntries     OversightDailyEntry[]
  resourceRequests          ResourceRequest[]
  designReviews             DesignReview[]
  auditFindings             AuditFinding[]
  equipmentAllocations      EquipmentAllocation[]
  executiveInterventions    ExecutiveIntervention[]
  roleAssignments           ProjectRoleAssignment[]
  objectives                ProjectObjective[]
  baselines                 ProjectBaseline[]
  statusHistory             ProjectStatusHistory[]
  progressSnapshots         ProgressSnapshot[]

  @@index([contractorOrgId])
  @@index([clientOrgId])
  @@index([status])
}

// ============================================================
// Team invitations (lead → worker onboarding)
// ============================================================

model Invitation {
  id       String   @id @default(cuid())
  email    String
  fullName String
  jobTitle String
  role     UserRole
  phone    String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  invitedById String
  invitedBy   User   @relation("InvitationsSent", fields: [invitedById], references: [id])

  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  projectRole String?

  tokenHash  String           @unique
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?

  acceptedUserId String? @unique
  acceptedUser   User?   @relation("InvitationAccepted", fields: [acceptedUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([email])
}

model Contract {
  id                   String         @id @default(cuid())
  projectId            String
  parentContractId     String?
  contractorOrgId      String
  scopeWbsNodeId       String?
  scopeDescription     String
  contractValue        Decimal        @db.Decimal(18, 2)
  retentionPercent     Decimal        @default(5) @db.Decimal(5, 2)
  status               ContractStatus @default(ACTIVE)
  terminatedAt         DateTime?
  supersedesContractId String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  project               Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentContract        Contract?             @relation("Subcontracts", fields: [parentContractId], references: [id])
  subcontracts          Contract[]            @relation("Subcontracts")
  contractorOrg         Organization          @relation("ContractOrg", fields: [contractorOrgId], references: [id])
  scopeWbsNode          WbsNode?              @relation(fields: [scopeWbsNodeId], references: [id])
  supersedes            Contract?             @relation("ContractSupersedeChain", fields: [supersedesContractId], references: [id])
  supersededBy          Contract[]            @relation("ContractSupersedeChain")
  measurements          MeasurementEntry[]
  planSubmissions       WbsPlanSubmission[]
  oversightAssignments  OversightAssignment[]
  oversightDailyEntries OversightDailyEntry[]
  resourceRequests      ResourceRequest[]
  materialDemands       MaterialDemand[]

  @@index([projectId])
  @@index([parentContractId])
  @@index([contractorOrgId])
  @@index([status])
  @@index([scopeWbsNodeId])
}

// ============================================================
// 4. Work Breakdown Structure (the shared spine)
// ============================================================

model WbsNode {
  id               String        @id @default(cuid())
  projectId        String
  parentId         String?
  code             String
  name             String
  nodeType         WBSNodeType
  designReady      Boolean       @default(false)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  status           WbsNodeStatus @default(ACTIVE)
  /// This node's share of its PARENT's completion, 0-100 (file 20 §2.2).
  /// Siblings must sum to 100 (the enforced "100% Rule"). Null on root nodes,
  /// which are 100% of their own subtree by definition, and null on legacy
  /// nodes created before weighting existed — the rollup falls back to equal
  /// weighting among unweighted siblings rather than silently scoring them 0.
  weightPercent    Decimal?      @db.Decimal(7, 4)
  /// Set when this node was created as part of a subcontractor's plan
  /// submission; nodes stay DRAFT until that submission is approved.
  planSubmissionId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent                WbsNode?               @relation("WBSChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children              WbsNode[]              @relation("WBSChildren")
  activities            ScheduleActivity[]
  boqItems              BoqItem[]
  stoppages             StoppageEntry[]
  measurements          MeasurementEntry[]
  variations            VariationOrder[]
  risks                 RiskEntry[]
  safetyObservations    SafetyObservation[]
  safetyIncidents       SafetyIncident[]
  inspections           InspectionTestRecord[]
  defects               DefectLog[]
  punchListItems        PunchListItem[]
  laborAssignments      LaborAssignment[]
  equipmentUsage        EquipmentUsageLog[]
  materialDemands       MaterialDemand[]
  structuralElements    StructuralElement[]
  designReviews         DesignReview[]
  earthworkDailyEntries EarthworkDailyEntry[]
  structureDailyEntries StructureDailyEntry[]
  rebarDailyEntries     RebarDailyEntry[]
  documents             ProjectDocument[]
  purchaseOrderItems    PurchaseOrderItem[]
  materialReceipts      MaterialReceipt[]
  decisions             DecisionLog[]
  lessonsLearned        LessonsLearned[]
  contractsAsScope      Contract[]
  disputeRecords        DisputeRecord[]
  sectionAssignments    SectionAssignment[]
  planSubmission        WbsPlanSubmission?     @relation("PlanSubmissionNodes", fields: [planSubmissionId], references: [id], onDelete: SetNull)
  planSubmissionsAsRoot WbsPlanSubmission[]    @relation("PlanSubmissionRoot")
  oversightAssignments  OversightAssignment[]
  oversightDailyEntries OversightDailyEntry[]
  resourceRequests      ResourceRequest[]

  @@unique([projectId, code])
  @@index([parentId])
  @@index([projectId, nodeType])
  @@index([projectId, status])
  @@index([planSubmissionId])
  @@map("WBSNode")
}

// ============================================================
// 5. Schedule
// ============================================================

model ScheduleActivity {
  id              String         @id @default(cuid())
  wbsNodeId       String
  name            String
  baselineStart   DateTime
  baselineFinish  DateTime
  plannedStart    DateTime
  plannedFinish   DateTime
  actualStart     DateTime?
  actualFinish    DateTime?
  progressPercent Decimal        @default(0) @db.Decimal(6, 2)
  status          ActivityStatus @default(NOT_STARTED)
  /// This activity's share of its WbsNode's completion, 0-100 (file 20 §2.2).
  /// Sibling activities under one node must sum to 100. Null falls back to
  /// equal weighting among unweighted siblings.
  weightPercent   Decimal?       @db.Decimal(7, 4)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  wbsNode                WbsNode                    @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)
  predecessors           ScheduleDependency[]       @relation("DependencyPredecessor")
  successors             ScheduleDependency[]       @relation("DependencySuccessor")
  stoppages              StoppageEntry[]
  safetyBlockedIncidents SafetyIncident[]
  assignments            ActivityAssignment[]
  dependencyRequests     PendingDependencyRequest[] @relation("DependencyRequestSuccessor")
  dependencyRequestsAs   PendingDependencyRequest[] @relation("DependencyRequestPredecessor")
  scheduleChangeRequests ScheduleChangeRequest[]

  @@index([wbsNodeId])
  @@index([status])
}

model ActivityAssignment {
  id                 String         @id @default(cuid())
  scheduleActivityId String
  userId             String
  role               AssignmentRole
  assignedById       String
  assignedAt         DateTime       @default(now())
  endedAt            DateTime?
  supersededById     String?

  scheduleActivity ScheduleActivity     @relation(fields: [scheduleActivityId], references: [id], onDelete: Cascade)
  user             User                 @relation("ActivityAssignedTo", fields: [userId], references: [id])
  assignedBy       User                 @relation("ActivityAssignedBy", fields: [assignedById], references: [id])
  supersededBy     ActivityAssignment?  @relation("ActivityAssignmentSupersede", fields: [supersededById], references: [id])
  supersedes       ActivityAssignment[] @relation("ActivityAssignmentSupersede")

  @@index([scheduleActivityId])
  @@index([userId])
  @@index([role])
  @@index([userId, role, endedAt])
}

model ScheduleDependency {
  id             String         @id @default(cuid())
  predecessorId  String
  successorId    String
  dependencyType DependencyType @default(FS)
  lagDays        Int            @default(0)

  predecessor ScheduleActivity @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   ScheduleActivity @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@index([predecessorId])
  @@index([successorId])
}

model PendingDependencyRequest {
  id             String                  @id @default(cuid())
  projectId      String
  predecessorId  String
  successorId    String
  dependencyType DependencyType          @default(FS)
  lagDays        Int                     @default(0)
  justification  String
  requestedById  String
  reviewedById   String?
  status         DependencyRequestStatus @default(PENDING)
  declineReason  String?
  createdAt      DateTime                @default(now())
  reviewedAt     DateTime?

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessor ScheduleActivity @relation("DependencyRequestPredecessor", fields: [predecessorId], references: [id])
  successor   ScheduleActivity @relation("DependencyRequestSuccessor", fields: [successorId], references: [id])
  requestedBy User             @relation("DepReqRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?            @relation("DepReqReviewedBy", fields: [reviewedById], references: [id])

  @@index([projectId, status])
  @@index([requestedById])
  @@index([reviewedById])
}

// Digital twin of the On-Site Work Stoppage Report (file 05 §1.5) —
// the single highest-leverage table in the system.
model StoppageEntry {
  id                      String            @id @default(cuid())
  projectId               String
  wbsNodeId               String?
  scheduleActivityId      String?
  stoppageType            StoppageType
  reason                  String
  stationFrom             String?
  stationTo               String?
  startTime               DateTime
  endTime                 DateTime
  resourcesAssigned       Json?
  inspectorComment        String?
  contractorRepComment    String?
  residentEngineerComment String?
  responsibleParty        ResponsibleParty?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode          WbsNode?          @relation(fields: [wbsNodeId], references: [id])
  scheduleActivity ScheduleActivity? @relation(fields: [scheduleActivityId], references: [id])
  realizedRisks    RiskEntry[]

  @@index([projectId])
  @@index([wbsNodeId])
  @@index([scheduleActivityId])
  @@index([stoppageType])
}

// ============================================================
// 5b. Daily Site Reports (digital twins — file 06 §2.1–2.3)
// ============================================================

// Earth Work Daily Report Format — IMS/OF/ENG/018 (file 06 §2.1).
// OH/IH/DH fields feed the cross-project Equipment Utilization view.
model EarthworkDailyEntry {
  id                  String            @id @default(cuid())
  projectId           String
  wbsNodeId           String
  date                DateTime          @db.Date
  station             String?
  activityDescription String
  equipmentType       String?
  equipmentPlateNo    String?
  operatingHours      Decimal?          @db.Decimal(6, 2)
  idleHours           Decimal?          @db.Decimal(6, 2)
  downHours           Decimal?          @db.Decimal(6, 2)
  quantityLength      Decimal?          @db.Decimal(12, 3)
  quantityWidth       Decimal?          @db.Decimal(12, 3)
  quantityDepth       Decimal?          @db.Decimal(12, 3)
  manpower            Json?
  remark              String?
  status              DailyReportStatus @default(DRAFT)
  createdById         String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode   WbsNode @relation(fields: [wbsNodeId], references: [id])
  createdBy User    @relation("EarthworkEntriesCreated", fields: [createdById], references: [id])

  @@index([projectId, date])
  @@index([wbsNodeId])
  @@index([status])
}

// Structure Daily Report Format — IMS/001 (file 06 §2.2).
// design/actual quantity variance closes the subjective-progress gap.
model StructureDailyEntry {
  id                  String            @id @default(cuid())
  projectId           String
  wbsNodeId           String
  date                DateTime          @db.Date
  activityDescription String
  designQuantity      Decimal?          @db.Decimal(12, 3)
  actualQuantity      Decimal?          @db.Decimal(12, 3)
  materialUsed        String?
  concreteGrade       String?
  labour              Json?
  equipmentType       String?
  equipmentSerialNo   String?
  operatingHours      Decimal?          @db.Decimal(6, 2)
  idleHours           Decimal?          @db.Decimal(6, 2)
  downHours           Decimal?          @db.Decimal(6, 2)
  remark              String?
  status              DailyReportStatus @default(DRAFT)
  createdById         String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode   WbsNode @relation(fields: [wbsNodeId], references: [id])
  createdBy User    @relation("StructureEntriesCreated", fields: [createdById], references: [id])

  @@index([projectId, date])
  @@index([wbsNodeId])
  @@index([status])
}

// Bar Schedule (Rebar) Daily Report — IMS/OF/ENG/019 (file 06 §2.3).
// Weight auto-computed from the WeightFactor lookup, replacing manual arithmetic.
model RebarDailyEntry {
  id               String            @id @default(cuid())
  projectId        String
  wbsNodeId        String
  date             DateTime          @db.Date
  barDesignation   String
  diameterMm       Int
  numberOfBars     Int
  lengthM          Decimal           @db.Decimal(12, 3)
  numberOfFaces    Int
  computedWeightKg Decimal?          @db.Decimal(18, 3)
  shape            String?
  labour           Json?
  remark           String?
  status           DailyReportStatus @default(DRAFT)
  createdById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode      WbsNode      @relation(fields: [wbsNodeId], references: [id])
  createdBy    User         @relation("RebarEntriesCreated", fields: [createdById], references: [id])
  weightFactor WeightFactor @relation(fields: [diameterMm], references: [diameterMm])

  @@index([projectId, date])
  @@index([wbsNodeId])
  @@index([status])
}

// ============================================================
// 6. Cost, BoQ & Payment
// ============================================================

model BoqItem {
  id               String   @id @default(cuid())
  wbsNodeId        String
  itemCode         String
  description      String
  unit             String
  budgetedQuantity Decimal  @db.Decimal(18, 3)
  unitRate         Decimal  @db.Decimal(18, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  wbsNode WbsNode      @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)
  actuals CostActual[]

  @@index([wbsNodeId])
  @@map("BoQItem")
}

model CostActual {
  id         String         @id @default(cuid())
  boqItemId  String
  costType   CostType
  amount     Decimal        @db.Decimal(18, 2)
  sourceType CostSourceType
  sourceId   String
  recordedAt DateTime
  createdAt  DateTime       @default(now())

  boqItem    BoqItem     @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  defectLogs DefectLog[]

  @@index([boqItemId])
  @@index([costType])
  @@index([sourceType, sourceId])
}

// Generalized IPC / subcontract measurement (file 06 §2.6).
model MeasurementEntry {
  id            String            @id @default(cuid())
  contractId    String
  wbsNodeId     String
  itemNo        String
  locationFrom  String?
  locationTo    String?
  side          String?
  length        Decimal?          @db.Decimal(18, 3)
  width         Decimal?          @db.Decimal(18, 3)
  depth         Decimal?          @db.Decimal(18, 3)
  quantity      Decimal           @db.Decimal(18, 3)
  unitRate      Decimal           @db.Decimal(18, 2)
  certificateNo String?
  status        MeasurementStatus @default(DRAFT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  wbsNode  WbsNode  @relation(fields: [wbsNodeId], references: [id])

  @@index([contractId])
  @@index([wbsNodeId])
  @@index([status])
}

// Digital twin of the Day Work Format → Variation Order (file 06 §2.4).
model VariationOrder {
  id              String               @id @default(cuid())
  projectId       String
  wbsNodeId       String?
  itemNo          String
  workDescription String
  equipmentUsed   Json?
  manpowerUsed    Json?
  materialUsed    Json?
  costImpact      Decimal?             @db.Decimal(18, 2)
  timeImpactDays  Int?
  status          VariationOrderStatus @default(DRAFT)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode       WbsNode?      @relation(fields: [wbsNodeId], references: [id])
  realizedRisks RiskEntry[]
  decisions     DecisionLog[]

  @@index([projectId])
  @@index([wbsNodeId])
  @@index([status])
}

// ============================================================
// 7. Risk
// ============================================================

model RiskEntry {
  id                    String       @id @default(cuid())
  projectId             String
  wbsNodeId             String?
  category              RiskCategory
  description           String
  likelihood            Int
  impact                Int
  ownerId               String
  mitigationPlan        String?
  status                RiskStatus   @default(OPEN)
  realizedAsStoppageId  String?
  realizedAsVariationId String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode             WbsNode?        @relation(fields: [wbsNodeId], references: [id])
  owner               User            @relation("RiskOwner", fields: [ownerId], references: [id])
  realizedAsStoppage  StoppageEntry?  @relation(fields: [realizedAsStoppageId], references: [id])
  realizedAsVariation VariationOrder? @relation(fields: [realizedAsVariationId], references: [id])
  decisions           DecisionLog[]

  @@index([projectId])
  @@index([wbsNodeId])
  @@index([ownerId])
  @@index([status])
  @@index([category])
}

// ============================================================
// 8. Safety
// ============================================================

model SafetyObservation {
  id                   String         @id @default(cuid())
  wbsNodeId            String
  observedByUserId     String
  hazardDescription    String
  severity             SafetySeverity
  immediateActionTaken String?
  observedAt           DateTime
  createdAt            DateTime       @default(now())

  wbsNode    WbsNode          @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)
  observedBy User             @relation(fields: [observedByUserId], references: [id])
  incidents  SafetyIncident[]

  @@index([wbsNodeId])
  @@index([severity])
  @@index([observedAt])
}

model SafetyIncident {
  id                               String         @id @default(cuid())
  wbsNodeId                        String
  linkedObservationId              String?
  incidentType                     IncidentType
  description                      String
  correctiveAction                 String?
  correctiveActionVerifiedByUserId String?
  status                           IncidentStatus @default(OPEN)
  affectsScheduleActivityId        String?
  createdAt                        DateTime       @default(now())
  updatedAt                        DateTime       @updatedAt

  wbsNode                    WbsNode            @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)
  linkedObservation          SafetyObservation? @relation(fields: [linkedObservationId], references: [id])
  correctiveActionVerifiedBy User?              @relation("IncidentVerifiedBy", fields: [correctiveActionVerifiedByUserId], references: [id])
  affectsScheduleActivity    ScheduleActivity?  @relation(fields: [affectsScheduleActivityId], references: [id])

  @@index([wbsNodeId])
  @@index([status])
  @@index([incidentType])
}

// ============================================================
// 9. Quality
// ============================================================

model InspectionTestRecord {
  id                String    @id @default(cuid())
  wbsNodeId         String
  inspectionType    String
  result            ITRResult
  inspectedByUserId String
  inspectedAt       DateTime
  createdAt         DateTime  @default(now())

  wbsNode                WbsNode         @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)
  inspectedBy            User            @relation(fields: [inspectedByUserId], references: [id])
  defects                DefectLog[]
  disputesFromInspection DisputeRecord[]

  @@index([wbsNodeId])
  @@index([result])
}

model DefectLog {
  id                 String          @id @default(cuid())
  linkedItrId        String?
  wbsNodeId          String
  description        String
  disputesFromDefect DisputeRecord[]
  responsibleOrgId   String?
  reworkCostActualId String?
  reworkDelayDays    Int?
  status             DefectStatus    @default(OPEN)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  linkedItr        InspectionTestRecord? @relation(fields: [linkedItrId], references: [id])
  wbsNode          WbsNode               @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)
  responsibleOrg   Organization?         @relation(fields: [responsibleOrgId], references: [id])
  reworkCostActual CostActual?           @relation(fields: [reworkCostActualId], references: [id])

  @@index([wbsNodeId])
  @@index([status])
}

model DisputeRecord {
  id           String        @id @default(cuid())
  defectLogId  String?
  itrId        String?
  projectId    String
  wbsNodeId    String?
  disputedById String
  reason       String
  resolution   String?
  status       DisputeStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  escalationTo String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  defectLog  DefectLog?            @relation(fields: [defectLogId], references: [id])
  itr        InspectionTestRecord? @relation(fields: [itrId], references: [id])
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode    WbsNode?              @relation(fields: [wbsNodeId], references: [id])
  disputedBy User                  @relation("DisputeOpenedBy", fields: [disputedById], references: [id])
  resolvedBy User?                 @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])

  @@index([projectId])
  @@index([defectLogId])
  @@index([status])
}

model PunchListItem {
  id          String        @id @default(cuid())
  wbsNodeId   String
  description String
  severity    PunchSeverity
  status      PunchStatus   @default(OPEN)
  patternTag  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  wbsNode WbsNode @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)

  @@index([wbsNodeId])
  @@index([status])
  @@index([patternTag])
}

// ============================================================
// 10. Resources — Labor
// ============================================================

model Employee {
  id             String         @id @default(cuid())
  organizationId String
  fullName       String
  profession     String
  employmentType EmploymentType
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  attendance   LaborAttendance[]
  assignments  LaborAssignment[]

  @@index([organizationId])
  @@index([employmentType])
}

model LaborAttendance {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime @db.Date
  present    Boolean
  hours      Decimal  @db.Decimal(5, 2)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model LaborAssignment {
  id          String   @id @default(cuid())
  employeeId  String
  wbsNodeId   String
  date        DateTime @db.Date
  hoursOnTask Decimal  @db.Decimal(5, 2)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  wbsNode  WbsNode  @relation(fields: [wbsNodeId], references: [id])

  @@index([employeeId, date])
  @@index([wbsNodeId])
}

// ============================================================
// 11. Resources — Equipment
// ============================================================

model Equipment {
  id             String   @id @default(cuid())
  organizationId String
  equipmentType  String
  plateNo        String?
  serialNo       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization          @relation(fields: [organizationId], references: [id])
  usageLogs        EquipmentUsageLog[]
  custodyLogs      CustodyLog[]
  resourceRequests ResourceRequest[]
  allocations      EquipmentAllocation[]

  @@index([organizationId])
}

model EquipmentUsageLog {
  id             String   @id @default(cuid())
  equipmentId    String
  wbsNodeId      String
  projectId      String
  date           DateTime @db.Date
  operatingHours Decimal  @db.Decimal(6, 2)
  idleHours      Decimal  @db.Decimal(6, 2)
  downHours      Decimal  @db.Decimal(6, 2)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  wbsNode   WbsNode   @relation(fields: [wbsNodeId], references: [id])
  project   Project   @relation(fields: [projectId], references: [id])

  @@index([equipmentId, date])
  @@index([projectId])
  @@index([wbsNodeId])
}

model EquipmentAllocation {
  id            String    @id @default(cuid())
  equipmentId   String
  projectId     String
  allocatedFrom DateTime  @db.Date
  allocatedTo   DateTime  @db.Date
  purpose       String
  allocatedById String
  releasedAt    DateTime?
  createdAt     DateTime  @default(now())

  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allocatedBy User      @relation(fields: [allocatedById], references: [id])

  @@index([equipmentId, allocatedFrom, allocatedTo])
  @@index([projectId, allocatedFrom, allocatedTo])
}

// ============================================================
// 12. Resources — Materials & Chain of Custody
// ============================================================

model MaterialItem {
  id              String   @id @default(cuid())
  name            String
  unit            String
  importDependent Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  demands            MaterialDemand[]
  custodyLogs        CustodyLog[]
  purchaseOrderItems PurchaseOrderItem[]
  receipts           MaterialReceipt[]
  resourceRequests   ResourceRequest[]

  @@index([name])
}

model MaterialDemand {
  id                     String   @id @default(cuid())
  wbsNodeId              String
  materialItemId         String
  neededByDate           DateTime @db.Date
  quantityNeeded         Decimal  @db.Decimal(18, 3)
  quantityDelivered      Decimal  @default(0) @db.Decimal(18, 3)
  /// Set when this demand originated from a subcontractor's resource request
  /// (file 20 §5.4) rather than the main contractor's own planning.
  requestedForContractId String?

  wbsNode              WbsNode      @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)
  materialItem         MaterialItem @relation(fields: [materialItemId], references: [id])
  requestedForContract Contract?    @relation(fields: [requestedForContractId], references: [id])

  purchaseOrderItems PurchaseOrderItem[]
  resourceRequest    ResourceRequest?

  @@index([wbsNodeId])
  @@index([materialItemId])
  @@index([neededByDate])
  @@index([requestedForContractId])
}

// Anti-theft / chain-of-custody tracking (file 03 §6).
model CustodyLog {
  id                  String   @id @default(cuid())
