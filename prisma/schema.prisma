  OTHER
}

enum ResponsibleParty {
  CLIENT
  CONSULTANT
  CONTRACTOR
  SUBCONTRACTOR
  NEUTRAL
}

enum CostType {
  COMMITTED
  ACTUAL
}

enum CostSourceType {
  PURCHASE_ORDER
  INVOICE
  PAYROLL
  EQUIPMENT_USAGE
  VARIATION_ORDER
}

enum MeasurementStatus {
  DRAFT
  SUBMITTED
  CONSULTANT_QUERIED
  CERTIFIED
  PAID
}

enum VariationOrderStatus {
  DRAFT
  CONTRACTOR_PREPARED
  CONTRACTOR_CHECKED
  CONSULTANT_CHECKED
  CONSULTANT_APPROVED
  REJECTED
