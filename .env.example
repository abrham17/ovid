# Copy to .env and adjust for your environment.
# Local dev uses system PostgreSQL via a unix-socket peer-auth connection.
DATABASE_URL="postgresql://abrhame@localhost/ovid_pms?host=/var/run/postgresql&schema=public"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Trust the proxy host header in development
AUTH_TRUST_HOST="true"
