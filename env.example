# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ovid?schema=public"

# Auth
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="Ovid PMS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# First technical administrator. Provision this user through the deployment
# bootstrap before opening the Company Staff administration area.
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_NAME="System Administrator"
BOOTSTRAP_ADMIN_PASSWORD="change-this-before-production"
# Optional exact contractor organization identity. Required when more than one
# contractor organization exists during production bootstrap.
BOOTSTRAP_ORGANIZATION_ID=""

# Company governance thresholds (ETB)
HIGH_VALUE_CONTRACT_THRESHOLD_ETB="50000000"
HIGH_VALUE_VARIATION_THRESHOLD_ETB="10000000"
HIGH_VALUE_IPC_THRESHOLD_ETB="5000000"
# Specialist approval must be complete before these CEO countersignatures are created.
GM_CONTRACT_COUNTERSIGN_THRESHOLD_ETB="100000000"
GM_VARIATION_COUNTERSIGN_THRESHOLD_ETB="25000000"
